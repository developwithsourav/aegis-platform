# AEGIS environment variables
# Set these in the Convex dashboard (Settings -> Environment Variables).
# Never commit real values. The system runs WITHOUT any of these
# (AI triage falls back to deterministic rules + SOP lookup).

# Which LLM powers triage: anthropic | openai | gemini | (empty = rule fallback)
LLM_PROVIDER=

# Provider keys (only the one matching LLM_PROVIDER is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Command dashboard operator login. REQUIRED: with no OPERATOR_PASSWORD set,
# the login fails closed and the dashboard is unreachable. Set real values with
#   npx convex env set OPERATOR_PASSWORD "<your password>"
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# Shared passcode for responder devices. Same fail-closed rule as above.
RESPONDER_PASSCODE=

# Public demo: masks callback numbers, turns off photo upload and free-text
# broadcasts, rate limits reports, adds one-click demo entry, resets hourly.
DEMO_MODE=
