{
  "name": "aegis-platform",
  "private": true,
  "version": "1.0.0",
  "description": "AEGIS: a venue operations prototype for crowd emergencies. Convex backend, static web app.",
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "seed": "convex run seed:all",
    "embed": "convex run ai:embedAllSops",
    "reset": "convex run seed:resetIncidents",
    "app": "python -m http.server 4320 --directory web",
    "typecheck": "tsc --noEmit -p convex"
  },
  "dependencies": {
    "convex": "^1.42.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "~6.0.2"
  }
}